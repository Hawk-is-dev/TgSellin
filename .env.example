BOT_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id_here

# Telegram API credentials (my.telegram.org se)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# optional - default zerox_otp_bot (separate DB inside the same cluster)
# DATABASE_NAME=zerox_otp_bot

# Numeric chat IDs (e.g. -1001234567890)
ADMIN_LOG_GROUP_ID=private admin log group id
FORCE_JOIN_PRIVATE_ID=private force-join channel id
